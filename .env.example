# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
# In Claude Code cloud sessions ANTHROPIC_API_KEY is withheld; use this name instead.
YELLOWBOOK_ANTHROPIC_API_KEY=

# The cost ladder (see docs/COST.md).
# Tier 1 reads the agency's own site with fetch only (no paid search). Tier 2 adds web search for what tier 1 could not settle.
# Tier 3 (stronger model) is off unless MAX_TIER=3.
MODEL_T1=claude-haiku-5-5
MODEL_T2=claude-haiku-5-5
MODEL_T3=claude-sonnet-5-5
MAX_TIER=2

# Per-seat tool budgets and size caps
T1_MAX_FETCHES=4
T2_MAX_SEARCHES=2
T2_MAX_FETCHES=3
MAX_CONTENT_TOKENS=12000
MAX_OUTPUT_TOKENS=1500

# Bulk runs use the Batch API (50% off tokens). SYNC_CONCURRENCY applies to --sync runs.
USE_BATCH=true
SYNC_CONCURRENCY=4

# Hard stop: no new request is sent once a run's estimated spend would pass this (USD)
MAX_RUN_COST_USD=25

# A seat is "due" after this many months. Seats that were searched and found nothing wait COOLDOWN_DAYS before a retry.
STALE_MONTHS=12
COOLDOWN_DAYS=30

# REVIEW_MODE=auto (default, owner decision): every finding is applied without review. Clear findings replace the
# holder (history kept as superseded); unclear or Low-confidence names are added beside the holder in a new slot.
# REVIEW_MODE=queue restores the human review queue, where the two settings below apply.
REVIEW_MODE=auto
# Review policy (queue mode): confirmations at or above this confidence are accepted without a human (High, Medium, Low or None).
# Replacements are never auto-accepted. QC_SAMPLE_RATE sends a random share of auto-accepts to review anyway.
AUTO_ACCEPT=High
QC_SAMPLE_RATE=0.05
ESCALATE_BELOW=Medium

# Planning guess used until real runs supply a measured rate
ESCALATION_RATE_GUESS=0.4

# Local files (git-ignored)
DATABASE_PATH=./data/yellowbook.sqlite
RAW_DIR=./data/raw
