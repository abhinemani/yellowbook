# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
# Model used for verification runs. Start with a Sonnet-class model; compare a Haiku-class model on a 25-seat pilot.
CLAUDE_MODEL=claude-sonnet-5-5

# Per-seat tool budget
MAX_SEARCHES_PER_SEAT=2
MAX_FETCHES_PER_SEAT=3

# A seat is "due" for re-check after this many months
STALE_MONTHS=12

# Local database file (git-ignored)
DATABASE_PATH=./data/yellowbook.sqlite
